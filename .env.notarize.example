# Copy to .env.notarize and fill in (never commit .env.notarize).
# Team ID from your Developer ID / membership: T6EB446J72

APPLE_TEAM_ID=T6EB446J72

# --- Recommended: keychain profile (leave password out of the file) ---
# Create once:
#   xcrun notarytool store-credentials "maccleaner-notary" \
#     --apple-id "you@email.com" \
#     --team-id "T6EB446J72" \
#     --password "xxxx-xxxx-xxxx-xxxx"
NOTARY_KEYCHAIN_PROFILE=maccleaner-notary

# --- Or Apple ID + app-specific password ---
# APPLE_ID=you@email.com
# APPLE_APP_SPECIFIC_PASSWORD=xxxx-xxxx-xxxx-xxxx

# --- Or App Store Connect API key ---
# APPLE_API_KEY=XXXXXXXXXX
# APPLE_API_ISSUER=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# APPLE_API_KEY_PATH=/absolute/path/to/AuthKey_XXXXXXXXXX.p8

# Optional override if multiple Developer ID certs exist:
# CODESIGN_IDENTITY=Developer ID Application: Matteo Ponzo (T6EB446J72)
